{
  "name": "florist-guide-monorepo",
  "version": "1.0.0",
  "description": "Fullstack-застосунок 'Довідник Флориста' на Payload CMS 3, Neon PostgreSQL, Vite та TypeScript",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"CMS,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:cms\" \"npm run dev:frontend\"",
    "dev:mock": "concurrently -n \"API,FRONTEND\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:cms": "npm --prefix cms run dev",
    "dev:backend": "npm --prefix backend run start",
    "build:frontend": "npm --prefix frontend run build",
    "build:cms": "npm --prefix cms run build",
    "typecheck:frontend": "npm --prefix frontend run typecheck"
  },
  "keywords": [
    "payload-cms",
    "typescript",
    "vite",
    "florist-guide",
    "neon",
    "postgresql",
    "monorepo"
  ],
  "author": "Гусаров, Юрчишин",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
