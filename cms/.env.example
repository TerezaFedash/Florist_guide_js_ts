# База даних Neon PostgreSQL (використовуйте pooled connection string)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Секретний ключ для шифрування сесій та токенів Payload
PAYLOAD_SECRET=your_32_bytes_random_hex_secret_here

# URL фронтенду для CORS політик (Vercel або localhost)
FRONTEND_URL=http://localhost:5173

# Базовий URL для Payload CMS
CMS_URL=http://localhost:3000

# Опціонально: Vercel Blob для збереження фото
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
